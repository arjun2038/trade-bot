# Binance Futures API Keys
# Get testnet keys from: https://testnet.binancefuture.com
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Set to True for testnet, False for live trading
USE_TESTNET=True

# Telegram Alerts (optional but recommended)
# Step 1: Message @BotFather on Telegram -> /newbot -> copy the token
# Step 2: Send /start to your bot, then visit:
#         https://api.telegram.org/bot<TOKEN>/getUpdates to get your chat_id
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Trading Parameters
SYMBOL=BTC/USDT:USDT
TIMEFRAME=15m
LEVERAGE=5
RISK_PER_TRADE=1.0       # % of balance risked per trade
MAX_OPEN_TRADES=2
DAILY_LOSS_LIMIT=5.0     # Stop trading if daily loss exceeds this %
